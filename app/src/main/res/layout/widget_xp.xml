<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#8CA999" android:textSize="11sp" />
    <TextView android:id="@+id/w_level" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Level 1" android:textColor="#E7F3EA" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_xp" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="0 XP" android:textColor="#F2C14E" android:textSize="15sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/w_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="0"
        android:progressTint="#5BD38A" android:progressBackgroundTint="#1F3D2D" />
    <TextView android:id="@+id/w_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Today 0 / 20" android:textColor="#E7F3EA" android:textSize="12sp" />
</LinearLayout>
